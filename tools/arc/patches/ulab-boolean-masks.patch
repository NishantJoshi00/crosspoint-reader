+// ARC extension: full-shape Boolean masks, including strided 2D views.
+static uint8_t *arc_linear_ptr(ndarray_obj_t *a, size_t n) {
+    int32_t offset = 0;
+    for(int d = ULAB_MAX_DIMS - 1; d >= ULAB_MAX_DIMS - a->ndim; --d) {
+        offset += (n % a->shape[d]) * a->strides[d];
+        n /= a->shape[d];
+    }
+    return (uint8_t *)a->array + offset;
+}
+
+static mp_obj_t arc_boolean_mask(ndarray_obj_t *a, ndarray_obj_t *mask, ndarray_obj_t *values) {
+    if(a->ndim != mask->ndim) {
+        mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("Boolean mask shape mismatch"));
+    }
+    for(int d = ULAB_MAX_DIMS - a->ndim; d < ULAB_MAX_DIMS; ++d) {
+        if(a->shape[d] != mask->shape[d]) {
+            mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("Boolean mask shape mismatch"));
+        }
+    }
+    size_t count = 0;
+    for(size_t n = 0; n < mask->len; ++n) count += *arc_linear_ptr(mask, n) != 0;
+    ndarray_obj_t *result;
+    if(values == NULL) {
+        result = ndarray_new_linear_array(count, a->dtype);
+    } else {
+        if(values->len != 1 && (values->len != count || (count != 0 && values->ndim != 1))) {
+            mp_raise_ValueError(MP_ERROR_TEXT("Boolean mask assignment length mismatch"));
+        }
+        result = ndarray_copy_view_convert_type(values, a->dtype);
+    }
+    size_t cursor = 0;
+    for(size_t n = 0; n < mask->len; ++n) {
+        if(*arc_linear_ptr(mask, n)) {
+            uint8_t *value = (uint8_t *)result->array + cursor * a->itemsize;
+            if(values == NULL) memcpy(value, arc_linear_ptr(a, n), a->itemsize);
+            else memcpy(arc_linear_ptr(a, n), value, a->itemsize);
+            if(values == NULL || values->len != 1) ++cursor;
+        }
+    }
+    return MP_OBJ_FROM_PTR(values == NULL ? result : a);
+}
+
+static mp_obj_t arc_integer_index(ndarray_obj_t *a, ndarray_obj_t *index, ndarray_obj_t *values) {
+    if(a->ndim != 1 || index->ndim != 1 || index->dtype == NDARRAY_FLOAT || index->dtype == 'c') {
+        mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("Expected 1D integer indices"));
+    }
+    if(values && values->len != 1 && values->len != index->len) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Indexed assignment length mismatch"));
+    }
+    ndarray_obj_t *result = values ? ndarray_copy_view_convert_type(values, a->dtype) : ndarray_new_linear_array(index->len, a->dtype);
+    for(size_t n = 0; n < index->len; ++n) {
+        int pos = mp_obj_get_int(ndarray_get_item(index, arc_linear_ptr(index, n)));
+        if(pos < 0) pos += a->len;
+        if(pos < 0 || (size_t)pos >= a->len) mp_raise_msg(&mp_type_IndexError, MP_ERROR_TEXT("Array index out of bounds"));
+        uint8_t *value = (uint8_t *)result->array + (values && values->len == 1 ? 0 : n) * a->itemsize;
+        if(values) memcpy(arc_linear_ptr(a, pos), value, a->itemsize);
+        else memcpy(value, arc_linear_ptr(a, pos), a->itemsize);
+    }
+    return MP_OBJ_FROM_PTR(values ? a : result);
+}
